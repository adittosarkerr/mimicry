# Mimic environment. Copy to .env.local and fill in.
# .env.local is gitignored. NEVER commit real keys.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# --- DeepSeek (server-side only, never exposed to browser/extension) ---
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Speech to text ---
# Works out of the box: with no key set, Whisper runs locally on the runner.
# The model downloads once (~40MB) and is cached under RUNNER_STORAGE_DIR.
# STT_LOCAL=0            # turn local transcription off entirely
# STT_LOCAL_MODEL=onnx-community/whisper-base.en   # more accurate, slower
#
# Optional hosted provider — takes precedence over the local model.
# The browser's own Web Speech API is tried first, but Brave and some Chromium
# builds refuse it with a network error. Set these and Mimic uploads the audio
# instead. Any OpenAI-compatible /audio/transcriptions endpoint works —
# OpenAI, Groq, or a local whisper server.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- Runner ---
RUNNER_PORT=8787
RUNNER_PUBLIC_URL=http://localhost:8787
# shared secret between web <-> runner <-> extension
MIMIC_INGEST_TOKEN=dev-local-token-change-me
# headless | headful ; headful fallback kicks in automatically on bot-walls
RUNNER_HEADLESS=true
RUNNER_MAX_CONCURRENCY=3
RUNNER_STEP_TIMEOUT_MS=15000
RUNNER_STORAGE_DIR=./.mimic

# --- Web ---
NEXT_PUBLIC_RUNNER_URL=http://localhost:8787
NEXT_PUBLIC_RUNNER_WS=ws://localhost:8787

# --- Supabase (leave blank to run on the local stub adapter) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Plan limits ---
# The free plan's daily run allowance is always counted. Set this to 1 to make
# it actually refuse a run once the allowance is used. Off by default so a
# development session isn't walled off after three runs.
MIMIC_ENFORCE_QUOTA=0
